# BTC Bot · variables de despliegue (copiar a .env)
#   cp .env.example .env

# Zona horaria del contenedor (afecta logs, backups y "hoy")
TZ=America/La_Paz

# --------------------------------------------------------------- red
# Interfaz para el panel/API.
#   0.0.0.0  = accesible desde toda tu LAN (usá firewall/VPN)
#   127.0.0.1 = solo desde el servidor (accedé con tunnel SSH)
HTTP_BIND=0.0.0.0
HTTP_PORT=8000

# noVNC (instalación y login de MT5 desde el navegador).
# Recomendado: dejarlo en 127.0.0.1 y usar tunnel SSH.
VNC_BIND=127.0.0.1

# ---------------------------------------------------------- arranque
# 1 = el bot se inicia solo cada vez que levanta el contenedor
AUTOSTART=1

# paper = precios reales MT5, dinero virtual (EMPEZÁ ACÁ)
# live  = órdenes reales en la cuenta conectada en MT5
# sim   = serie sintética, sin MT5
AUTOSTART_MODE=paper

# true SOLO si AUTOSTART_MODE=live y la cuenta de MT5 es REAL.
# El bot exige confirmación explícita antes de operar en real.
AUTOSTART_CONFIRM_REAL=false

# Interfaz gráfica de MT5 accesible por navegador (1 = sí).
# Puedes ponerlo en 0 cuando ya hayas instalado y logueado MT5.
ENABLE_VNC=1

# ----------------------------------------------------------- backups
# Hora (contenedor, formato 24h) en que se hace el backup diario de bot.db
BACKUP_HOUR=4
# Cuántos backups diarios conservar
BACKUP_KEEP=7
